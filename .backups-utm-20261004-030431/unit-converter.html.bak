<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5"><title>Aspirant Unit Converter · Master Hub</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📐</text></svg>"><style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:system-ui,sans-serif;background:radial-gradient(circle at 20% 10%,#eef4fb,#dde6f2);min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:clamp(8px,1.5vw,16px)}
.w{width:100%;max-width:560px;background:rgba(255,255,255,.9);backdrop-filter:blur(20px);border-radius:clamp(18px,3.5vw,28px);padding:clamp(16px,2.5vw,26px);box-shadow:0 30px 60px -20px rgba(20,40,80,.25);position:relative}
.hub{position:absolute;top:12px;left:12px;background:#1e3b5c;color:#fff;text-decoration:none;font-size:.7rem;font-weight:600;padding:5px 11px;border-radius:999px}
h1{margin:6px 0 4px;color:#1e2b3c;font-size:clamp(1.15rem,3.5vw,1.45rem);text-align:center;font-weight:700}
.sub{text-align:center;color:#5a6f88;font-size:.78rem;margin-bottom:10px}
.tabs{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.tab{background:#eaf0f9;color:#1e3b5c;border:none;padding:.45rem .85rem;border-radius:20px;font-size:.72rem;font-weight:600;cursor:pointer;transition:.15s}
.tab.on{background:#1e3b5c;color:#fff}
label{display:block;color:#5a6f88;font-size:.7rem;font-weight:600;margin-top:8px;text-transform:uppercase;letter-spacing:.05em}
input,select{width:100%;padding:10px 13px;border:1px solid #d5e0ed;border-radius:11px;box-sizing:border-box;font-size:.9rem;background:#fff;margin-top:4px}
input:focus,select:focus{outline:none;border-color:#1e3b5c;box-shadow:0 0 0 3px rgba(30,59,92,.12)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.out{background:linear-gradient(135deg,#1e3b5c,#2f5575);color:#fff;padding:14px;border-radius:13px;text-align:center;font-size:clamp(1.1rem,3.5vw,1.4rem);font-weight:700;margin-top:12px;word-break:break-all}
.share{display:flex;gap:6px;margin-top:10px;justify-content:center;flex-wrap:wrap}
.share a{text-decoration:none;padding:7px 14px;border-radius:999px;font-size:.75rem;font-weight:600}
.share a.wa{background:#25D366;color:#fff}
.share a.tg{background:#0088cc;color:#fff}
</style>  <script data-goatcounter="https://quicktools.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head><body>
<div class="w">
<a href="../" class="hub">🏠 Hub</a>
<h1>📐 Aspirant Unit Converter</h1>
<p class="sub">Length, weight, area, speed & data units.</p>
<div class="tabs" id="tabs"></div>
<label>Value</label><input type="number" id="val" value="1" step="any">
<div class="row">
<div><label>From</label><select id="from"></select></div>
<div><label>To</label><select id="to"></select></div>
</div>
<div class="out" id="out">—</div>
<div class="share">
<span style="font-size:.75rem;color:#5a6f88;align-self:center">Share:</span>
<a class="wa" href="https://wa.me/?text=Check%20Unit%20Converter%3A%20https://unknownuniversem-blip.github.io/unit-converter/" target="_blank">💬 WhatsApp</a>
<a class="tg" href="https://t.me/share/url?url=https://unknownuniversem-blip.github.io/unit-converter/" target="_blank">✈️ Telegram</a>
</div>
</div>
<script>
const $=i=>document.getElementById(i);
const U={
Length:{m:1,km:1000,cm:0.01,mm:0.001,mile:1609.34,ft:0.3048,in:0.0254,yd:0.9144,nm:1852},
Weight:{kg:1,g:0.001,mg:1e-6,lb:0.453592,oz:0.0283495,ton:1000,quintal:100},
Area:{m2:1,km2:1e6,cm2:1e-4,ft2:0.092903,acre:4046.86,hectare:10000,bigha:2529.3,guntha:101.17},
Speed:{ms:1,kmh:0.277778,mph:0.44704,knot:0.514444},
Data:{B:1,KB:1024,MB:1048576,GB:1073741824,TB:1.0995e12},
Time:{s:1,min:60,hour:3600,day:86400,week:604800}
};
let cur="Length";
function render(){
  $("tabs").innerHTML=Object.keys(U).map(k=>`<button class="tab${k===cur?" on":""}" data-k="${k}">${k}</button>`).join("");
  const keys=Object.keys(U[cur]);
  $("from").innerHTML=keys.map(k=>`<option>${k}</option>`).join("");
  $("to").innerHTML=keys.map(k=>`<option>${k}</option>`).join("");
  $("to").value=keys[1]||keys[0];
  conv();
}
function conv(){
  const v=parseFloat($("val").value)||0;
  const f=$("from").value,t=$("to").value;
  const out=v*U[cur][f]/U[cur][t];
  $("out").textContent=Number(out.toFixed(6)).toLocaleString()+" "+t;
}
$("tabs").onclick=e=>{if(e.target.dataset.k){cur=e.target.dataset.k;render()}};
$("val").oninput=conv;$("from").onchange=conv;$("to").onchange=conv;
render();
</script></body></html>
