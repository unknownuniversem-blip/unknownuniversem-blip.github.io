<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5"><title>7-Min Home Workout Coach · Master Hub</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💪</text></svg>"><style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:system-ui,sans-serif;background:radial-gradient(circle at 20% 10%,#eef4fb,#dde6f2);min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:clamp(8px,1.5vw,16px)}
.w{width:100%;max-width:520px;background:rgba(255,255,255,.9);backdrop-filter:blur(20px);border-radius:clamp(18px,3.5vw,28px);padding:clamp(16px,2.5vw,26px);text-align:center;box-shadow:0 30px 60px -20px rgba(20,40,80,.25);position:relative}
.hub{position:absolute;top:12px;left:12px;background:#1e3b5c;color:#fff;text-decoration:none;font-size:.7rem;font-weight:600;padding:5px 11px;border-radius:999px}
h1{margin:6px 0 4px;color:#1e2b3c;font-size:clamp(1.15rem,3.5vw,1.45rem);font-weight:700}
.sub{color:#5a6f88;font-size:.78rem;margin-bottom:12px}
.exercise{background:linear-gradient(135deg,#1e3b5c,#2f5575);color:#fff;border-radius:16px;padding:clamp(20px,5vw,36px) 20px;margin:12px 0;box-shadow:0 20px 40px -10px rgba(30,59,92,.5)}
.exercise .name{font-size:clamp(1.3rem,4vw,1.8rem);font-weight:700;margin-bottom:4px}
.exercise .timer{font-size:clamp(2.5rem,10vw,4rem);font-weight:700;font-variant-numeric:tabular-nums;line-height:1}
.exercise .phase{font-size:.72rem;text-transform:uppercase;letter-spacing:2px;opacity:.85;margin-bottom:8px}
.btns{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:12px}
.btns button{border:none;padding:12px;border-radius:11px;font-weight:600;cursor:pointer;font-size:.82rem}
.btns button.go{background:linear-gradient(135deg,#2e7d32,#1b5e20);color:#fff}
.btns button.pause{background:linear-gradient(135deg,#f9a825,#e68900);color:#1e2b3c}
.btns button.reset{background:#eaf0f9;color:#1e3b5c}
.list{background:#f6f9fd;border-radius:11px;padding:10px;font-size:.75rem;color:#5a6f88;margin-top:10px;text-align:left;max-height:120px;overflow-y:auto;line-height:1.7}
.list b{color:#1e3b5c}
.share{display:flex;gap:6px;margin-top:10px;justify-content:center;flex-wrap:wrap}
.share a{text-decoration:none;padding:7px 14px;border-radius:999px;font-size:.75rem;font-weight:600}
.share a.wa{background:#25D366;color:#fff}
.share a.tg{background:#0088cc;color:#fff}
</style>  <script data-goatcounter="https://quicktools.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head><body>
<div class="w">
<a href="../" class="hub">🏠 Hub</a>
<h1>💪 7-Min Home Workout</h1>
<p class="sub">Zero-equipment bodyweight routine — voice & timer guided.</p>
<div class="exercise">
<div class="phase" id="phase">Ready</div>
<div class="name" id="exName">Push-ups</div>
<div class="timer" id="timer">30</div>
</div>
<div class="btns">
<button class="go" id="startBtn" onclick="toggle()">▶ Start</button>
<button class="reset" onclick="skip()">⏭ Skip</button>
<button class="reset" onclick="reset()">↺ Reset</button>
</div>
<div class="list" id="list"></div>
<div class="share">
<span style="font-size:.72rem;color:#5a6f88;align-self:center">Share:</span>
<a class="wa" href="https://wa.me/?text=Check%207-Min%20Workout%3A%20https://unknownuniversem-blip.github.io/home-workout/" target="_blank">💬 WhatsApp</a>
<a class="tg" href="https://t.me/share/url?url=https://unknownuniversem-blip.github.io/home-workout/" target="_blank">✈️ Telegram</a>
</div>
</div>
<script>
const $=i=>document.getElementById(i);
const ROUTINE=[
  {n:"Jumping Jacks",t:30},{n:"Rest",t:10},
  {n:"Wall Sit",t:30},{n:"Rest",t:10},
  {n:"Push-ups",t:30},{n:"Rest",t:10},
  {n:"Ab Crunch",t:30},{n:"Rest",t:10},
  {n:"Step-ups",t:30},{n:"Rest",t:10},
  {n:"Squats",t:30},{n:"Rest",t:10},
  {n:"Tricep Dips",t:30},{n:"Rest",t:10},
  {n:"Plank",t:30},{n:"Rest",t:10},
  {n:"High Knees",t:30},{n:"Rest",t:10},
  {n:"Lunges",t:30},{n:"Rest",t:10},
  {n:"Push-up Rotation",t:30},{n:"Rest",t:10},
  {n:"Side Plank L",t:30},{n:"Rest",t:10},
  {n:"Side Plank R",t:30}
];
let idx=0,remaining=ROUTINE[0].t,running=false,timer=null;
function render(){
  $("exName").textContent=ROUTINE[idx].n;
  $("timer").textContent=remaining;
  $("phase").textContent=running?"In Progress":(remaining===ROUTINE[idx].t?"Ready":"Paused");
  $("list").innerHTML=ROUTINE.map((r,i)=>`<div${i===idx?' style="color:#1e3b5c;font-weight:700"':''}>${i+1}. <b>${r.n}</b> — ${r.t}s</div>`).join("");
}
function beep(f=800,d=0.15){try{const ctx=new(window.AudioContext||window.webkitAudioContext)();const o=ctx.createOscillator();const g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.frequency.value=f;g.gain.value=0.2;o.start();o.stop(ctx.currentTime+d)}catch(e){}}
function tick(){
  remaining--;
  if(remaining<=0){
    if(idx+1>=ROUTINE.length){clearInterval(timer);running=false;beep(1200,0.5);alert("🎉 Workout complete!");reset();return}
    idx++;remaining=ROUTINE[idx].t;beep(remaining>15?600:900,0.2);
    if("speechSynthesis"in window){const u=new SpeechSynthesisUtterance(ROUTINE[idx].n);u.rate=1.2;speechSynthesis.speak(u)}
  }
  render();
}
function toggle(){
  if(running){clearInterval(timer);running=false}
  else{timer=setInterval(tick,1000);running=true}
  render();
}
function skip(){idx=(idx+1)%ROUTINE.length;remaining=ROUTINE[idx].t;render()}
function reset(){clearInterval(timer);running=false;idx=0;remaining=ROUTINE[0].t;render()}
render();
</script></body></html>
