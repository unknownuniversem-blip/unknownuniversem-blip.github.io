["Gaining Ratio","New Ratio − Old Ratio"],
["DRR","Debenture Redemption Reserve — 25% of FV"],
["DRI","Debenture Redemption Investment — 15% for listed"],
["EBIT","Earnings Before Interest & Tax"],
["EPS","Earnings Per Share = PAT ÷ No. of Shares"],
["DPS","Dividend Per Share"],
["P/E Ratio","Market Price ÷ EPS"],
["COGS","Cost of Goods Sold"],
["ROI","Return on Investment"],
["ROE","Return on Equity"],
["BRS","Bank Reconciliation Statement"],
["GAAP","Generally Accepted Accounting Principles"],
["NPO","Not-for-Profit Organisation"]
];
html = '<div class="chapter-header"><h2>📖 Glossary</h2><p>'+terms.length+' key accounting terms</p></div><div class="topic-section"><div class="formula-list">'+terms.map(t=>'<div class="formula"><div class="fl">'+t[0]+'</div><div class="fv" style="font-family:system-ui;font-weight:500;font-size:.78rem">'+t[1]+'</div></div>').join('')+'</div></div>';
}
html += '<div class="ad-slot"></div>';
$("chapterTitle").textContent = type.charAt(0).toUpperCase() + type.slice(1);
$("chapterContent").innerHTML = html;
showScreen("chapter");
}

/* SEARCH */
function openSearch(){
$("searchInput").value = "";
$("searchResults").innerHTML = "";
showScreen("search");
setTimeout(()=>$("searchInput").focus(), 100);
}

function doSearch(){
const q = $("searchInput").value.trim().toLowerCase();
if (!q){$("searchResults").innerHTML="";return}
let results = [];
[["Class 11", 11, CLASS_11],["Class 12", 12, CLASS_12]].forEach(([label, num, list])=>{
list.forEach((ch, i)=>{
const hay = [
ch.title, ch.summary,
...(ch.concepts||[]),
...(ch.formulas||[]).flat(),
ch.journal||"",
ch.formats||"",
...(ch.tips||[])
].join(" ").toLowerCase();
if (hay.includes(q)) results.push({label, num, i, ch});
});
});
if (!results.length){
$("searchResults").innerHTML = '<div class="recent-empty">No matches found</div>';
return;
}
$("searchResults").innerHTML = results.map(r=>'<button class="chapter-card" onclick="jumpTo('+r.num+','+r.i+')"><span class="ch-num">'+r.label+'</span><div class="ch-title">'+r.ch.title+'</div><div class="ch-sum">'+r.ch.summary+'</div></button>').join("");
}

function jumpTo(cls, idx){
currentClass = cls;
openChapter(idx);
}
</script>
