const CLASS_11 = [
{n:1, title:"Introduction to Accounting", summary:"Meaning, objectives, users, qualitative characteristics, branches",
concepts:[
"<strong>Accounting</strong> — Process of identifying, measuring, recording, classifying, summarising, analysing, interpreting & communicating financial information",
"<strong>Objectives:</strong> Maintain systematic records · Determine profit/loss · Show financial position · Provide information to users · Assist management in planning",
"<strong>Internal users:</strong> Owners, Management, Employees",
"<strong>External users:</strong> Investors, Creditors, Banks, Government, Consumers, Researchers",
"<strong>Branches:</strong> Financial Accounting · Cost Accounting · Management Accounting",
"<strong>Book-keeping vs Accounting vs Accountancy:</strong> Book-keeping = recording; Accounting = recording + summarising + interpreting; Accountancy = body of knowledge",
"<strong>Qualitative characteristics:</strong> Reliability · Relevance · Understandability · Comparability",
"<strong>Accounting information system:</strong> Source documents → Journal → Ledger → Trial Balance → Financial Statements"
],
formulas:[
["Accounting Equation","Assets = Liabilities + Capital"],
["Expanded equation","A = L + (Capital + Revenue − Expenses − Drawings)"],
["Capital","Assets − Liabilities"],
["Net Worth","Total Assets − External Liabilities"],
["Profit","Revenue − Expenses"],
["Drawings effect","Drawings reduce capital"]
],
journal:null, formats:null,
tips:[
"Every transaction always satisfies the accounting equation",
"Owner's equity = Capital + Revenue − Expenses − Drawings"
]},

{n:2, title:"Theory Base of Accounting", summary:"GAAP, accounting concepts, conventions, standards, bases of accounting",
concepts:[
"<strong>GAAP</strong> — Generally Accepted Accounting Principles: rules & conventions accountants follow",
"<strong>Entity concept:</strong> Business is separate from owner",
"<strong>Money measurement:</strong> Only money-measurable transactions recorded",
"<strong>Going concern:</strong> Business continues indefinitely",
"<strong>Accounting period:</strong> Life divided into equal periods (usually 1 year)",
"<strong>Cost concept:</strong> Assets recorded at acquisition cost, not market value",
"<strong>Dual aspect:</strong> Every transaction = 2 effects (debit + credit)",
"<strong>Revenue recognition:</strong> Revenue recorded when earned, not when received",
"<strong>Matching:</strong> Expenses matched with revenues of same period",
"<strong>Accrual basis:</strong> Record on earning/incurring basis",
"<strong>Cash basis:</strong> Record on cash receipt/payment basis",
"<strong>Full disclosure:</strong> All material facts disclosed",
"<strong>Consistency:</strong> Same methods period after period",
"<strong>Conservatism (Prudence):</strong> Provide for all losses, ignore anticipated profits",
"<strong>Materiality:</strong> Record only material items",
"<strong>Objectivity:</strong> Records based on verifiable evidence",
"<strong>Accounting Standards:</strong> Issued by ICAI — AS-1 to AS-29 and Ind-AS"
],
formulas:null, journal:null, formats:null,
tips:[
"Accrual basis is mandatory for companies",
"Conservatism ≠ understating; it's about not overstating assets/income"
]},

{n:3, title:"Recording of Transactions — Journal", summary:"Source documents, rules of debit/credit, journal entries, compound entries",
concepts:[
"<strong>Source documents:</strong> Cash memo, invoice, receipt, cheque, debit note, credit note, pay-in-slip",
"<strong>Journal:</strong> Book of original entry — chronological record",
"<strong>Rules of Debit/Credit:</strong>",
"  • <strong>Personal A/c:</strong> Debit the receiver, Credit the giver",
"  • <strong>Real A/c:</strong> Debit what comes in, Credit what goes out",
"  • <strong>Nominal A/c:</strong> Debit expenses/losses, Credit incomes/gains",
"<strong>Compound entry:</strong> One entry with multiple debits/credits",
"<strong>Narration:</strong> Brief explanation after each entry",
"<strong>L.F.:</strong> Ledger Folio — reference to ledger page"
],
formulas:null,
journal:`BASIC JOURNAL ENTRIES — COMMON TRANSACTIONS

1) Started business with cash ₹5,00,000
   Cash A/c                    Dr.   5,00,000
      To Capital A/c                          5,00,000

2) Purchased goods for cash ₹50,000
   Purchases A/c               Dr.     50,000
      To Cash A/c                               50,000

3) Purchased goods on credit from Ram ₹30,000
   Purchases A/c               Dr.     30,000
      To Ram's A/c                              30,000

4) Sold goods for cash ₹80,000
   Cash A/c                    Dr.     80,000
      To Sales A/c                              80,000

5) Sold goods on credit to Shyam ₹40,000
   Shyam's A/c                 Dr.     40,000
      To Sales A/c                              40,000

6) Cash received from Shyam ₹38,000 (discount ₹2,000)
   Cash A/c                    Dr.     38,000
   Discount Allowed A/c        Dr.      2,000
      To Shyam's A/c                            40,000

7) Cash paid to Ram ₹29,000 (discount ₹1,000)
   Ram's A/c                   Dr.     30,000
      To Cash A/c                               29,000
      To Discount Received A/c                   1,000

8) Salary paid ₹15,000
   Salaries A/c                Dr.     15,000
      To Cash A/c                               15,000

9) Rent paid ₹8,000
   Rent A/c                    Dr.      8,000
      To Cash A/c                                8,000

10) Commission received ₹5,000
    Cash A/c                   Dr.      5,000
       To Commission Received A/c                5,000

11) Goods withdrawn by owner ₹4,000
    Drawings A/c               Dr.      4,000
       To Purchases A/c                          4,000

12) Cash withdrawn for personal use ₹6,000
    Drawings A/c               Dr.      6,000
       To Cash A/c                                6,000

13) Purchased furniture for cash ₹25,000
    Furniture A/c              Dr.     25,000
       To Cash A/c                               25,000

14) Purchased machinery on credit ₹2,00,000
    Machinery A/c              Dr.  2,00,000
       To Creditor's A/c                      2,00,000

15) Depreciation on machinery @ 10% p.a.
    Depreciation A/c           Dr.     20,000
       To Machinery A/c                          20,000

16) Bad debts written off ₹3,000
    Bad Debts A/c              Dr.      3,000
       To Debtor's A/c                            3,000

17) Goods returned by customer ₹2,000
    Sales Return A/c           Dr.      2,000
       To Customer's A/c                          2,000

18) Goods returned to supplier ₹1,500
    Supplier's A/c             Dr.      1,500
       To Purchase Return A/c                     1,500

19) Interest on capital allowed ₹10,000
    Interest on Capital A/c    Dr.     10,000
       To Capital A/c                            10,000

20) Interest on drawings charged ₹2,000
    Drawings A/c               Dr.      2,000
       To Interest on Drawings A/c                2,000`,
formats:`JOURNAL FORMAT

Date    Particulars                     L.F.   Debit(₹)   Credit(₹)
──────────────────────────────────────────────────────────────────────
        [Account to be debited] Dr.            xxx
           To [Account to be credited]                    xxx
        (Narration)
──────────────────────────────────────────────────────────────────────
Total                                          xxx         xxx`,
