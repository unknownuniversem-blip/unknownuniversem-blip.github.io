]},

{n:5, title:"Bank Reconciliation Statement", summary:"Reconciliation, causes of difference, favourable balance, preparation",
concepts:[
"<strong>BRS:</strong> Statement reconciling bank balance per Cash Book with balance per Pass Book",
"<strong>Cash Book (Bank Column):</strong> Business's record of bank transactions",
"<strong>Pass Book:</strong> Bank's record of customer's account",
"<strong>Favourable balance (Credit in Pass Book):</strong> Business has money in bank",
"<strong>Unfavourable balance (Debit in Pass Book):</strong> Overdraft",
"<strong>Causes of difference:</strong>",
"  • Cheques issued but not presented",
"  • Cheques deposited but not cleared",
"  • Interest allowed by bank (not in Cash Book)",
"  • Bank charges (not in Cash Book)",
"  • Direct deposits by customers",
"  • Cheques dishonoured",
"  • Errors in Cash Book or Pass Book"
],
formulas:null,
journal:null,
