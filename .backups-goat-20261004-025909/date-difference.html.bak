<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Date Difference Calculator</title><meta name="viewport" content="width=device-width, initial-scale=1.0"><style>body{background:#070c18;color:#f8fafc;font-family:sans-serif;padding:20px;text-align:center}.box{max-width:440px;margin:auto;background:#0f172a;padding:24px;border-radius:14px;border:1px solid #1e293b;text-align:left}input{width:100%;padding:10px;margin:6px 0;border-radius:8px;border:1px solid #334155;background:#131d35;color:#fff;box-sizing:border-box}.res{margin-top:12px;padding:12px;background:#070c18;border-radius:8px;font-size:1.1rem;color:#38bdf8;font-weight:bold;text-align:center}</style></head><body><div class="box"><h3 style="text-align:center;color:#38bdf8">📅 Date Difference Calculator</h3><label style="font-size:0.8rem;color:#94a3b8">Start Date</label><input type="date" id="d1" value="2024-01-01" oninput="c()"><label style="font-size:0.8rem;color:#94a3b8">End Date</label><input type="date" id="d2" value="2026-10-04" oninput="c()"><div class="res" id="res">Diff: 1007 Days</div></div><script>function c(){const d1=new Date(document.getElementById('d1').value);const d2=new Date(document.getElementById('d2').value);const diff=Math.abs(Math.round((d2-d1)/(1000*60*60*24)));document.getElementById('res').innerText=`Diff: ${diff} Days (${Math.floor(diff/7)} Weeks)`;}c();</script></body></html>