<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Bigha & Land Unit Converter</title><meta name="viewport" content="width=device-width, initial-scale=1.0"><style>body{background:#070c18;color:#f8fafc;font-family:sans-serif;padding:20px;text-align:center}.box{max-width:440px;margin:auto;background:#0f172a;padding:24px;border-radius:14px;border:1px solid #1e293b;text-align:left}input,select{width:100%;padding:10px;margin:6px 0;border-radius:8px;border:1px solid #334155;background:#131d35;color:#fff;box-sizing:border-box}.res{margin-top:12px;padding:12px;background:#070c18;border-radius:8px;color:#38bdf8;font-weight:bold;text-align:center}</style></head><body><div class="box"><h3 style="text-align:center;color:#eab308">🌾 Regional Bigha & Land Converter</h3><label style="font-size:0.8rem;color:#94a3b8">Bigha (UP / North Standard)</label><input type="number" id="v" value="1" oninput="conv()"><div class="res" id="out">27,225 Sq. Feet | 20 Biswa</div></div><script>function conv(){const b=parseFloat(document.getElementById('v').value)||0;const sqft=b*27225;const biswa=b*20;const acre=(sqft/43560).toFixed(3);document.getElementById('out').innerHTML=`${sqft.toLocaleString()} Sq. Feet<br>${biswa} Biswa | ${acre} Acres`;}conv();</script></body></html>