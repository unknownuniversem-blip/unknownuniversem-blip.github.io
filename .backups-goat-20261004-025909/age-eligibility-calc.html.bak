<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5"><title>Age Eligibility Calculator · Master Hub</title><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎂</text></svg>"><style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:system-ui,sans-serif;background:radial-gradient(circle at 20% 10%,#eef4fb,#dde6f2);min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:clamp(8px,1.5vw,16px)}
.w{width:100%;max-width:560px;background:rgba(255,255,255,.9);backdrop-filter:blur(20px);border-radius:clamp(18px,3.5vw,28px);padding:clamp(16px,2.5vw,26px);box-shadow:0 30px 60px -20px rgba(20,40,80,.25);position:relative}
.hub{position:absolute;top:12px;left:12px;background:#1e3b5c;color:#fff;text-decoration:none;font-size:.7rem;font-weight:600;padding:5px 11px;border-radius:999px}
h1{margin:6px 0 4px;color:#1e2b3c;font-size:clamp(1.15rem,3.5vw,1.45rem);text-align:center;font-weight:700}
.sub{text-align:center;color:#5a6f88;font-size:.78rem;margin-bottom:12px}
label{display:block;color:#5a6f88;font-size:.7rem;font-weight:600;margin-top:8px;text-transform:uppercase;letter-spacing:.05em}
input,select{width:100%;padding:10px 13px;border:1px solid #d5e0ed;border-radius:11px;box-sizing:border-box;font-size:.88rem;background:#fff;margin-top:4px}
input:focus,select:focus{outline:none;border-color:#1e3b5c;box-shadow:0 0 0 3px rgba(30,59,92,.12)}
.btn{background:linear-gradient(135deg,#1e3b5c,#2f5575);color:#fff;border:none;padding:12px;border-radius:12px;font-weight:600;cursor:pointer;width:100%;margin-top:12px;font-size:.9rem;box-shadow:0 8px 20px -6px rgba(30,59,92,.5)}
.res{background:linear-gradient(135deg,#1e3b5c,#2f5575);color:#fff;border-radius:14px;padding:16px;margin-top:12px;text-align:center;display:none}
.res .big{font-size:clamp(1.4rem,4.5vw,1.8rem);font-weight:700;margin:.2rem 0}
.res .label{font-size:.7rem;opacity:.85;text-transform:uppercase;letter-spacing:.05em}
.res ul{text-align:left;margin:10px 0 0;padding-left:20px;font-size:.78rem;line-height:1.7;list-style:none}
.res ul li{position:relative;padding-left:4px}
.res ul li::before{content:"✓";position:absolute;left:-16px;font-weight:700}
.res ul li.no::before{content:"✗";color:#ff8a80}
.share{display:flex;gap:6px;margin-top:10px;justify-content:center;flex-wrap:wrap}
.share a{text-decoration:none;padding:7px 14px;border-radius:999px;font-size:.75rem;font-weight:600}
.share a.wa{background:#25D366;color:#fff}
.share a.tg{background:#0088cc;color:#fff}
</style></head><body>
<div class="w">
<a href="../" class="hub">🏠 Hub</a>
<h1>🎂 Age Eligibility Calculator</h1>
<p class="sub">Check if you meet age criteria for SSC, UPSC, IBPS, Railways.</p>
<label>Date of Birth</label><input type="date" id="dob">
<label>Cutoff Date (exam notification)</label><input type="date" id="cutoff">
<label>Exam</label>
<select id="exam">
<option value="ssc">SSC CGL (18-32)</option>
<option value="upsc">UPSC CSE (21-32)</option>
<option value="ibps">IBPS PO (20-30)</option>
<option value="railways">Railways NTPC (18-33)</option>
<option value="custom">Custom Range</option>
</select>
<div id="customBox" style="display:none">
<label>Min Age</label><input type="number" id="minAge" value="18">
<label>Max Age</label><input type="number" id="maxAge" value="32">
</div>
<label>Category (age relaxation)</label>
<select id="cat">
<option value="gen">General (0 yrs)</option>
<option value="obc">OBC (+3 yrs)</option>
<option value="scst">SC/ST (+5 yrs)</option>
<option value="pwd">PwD (+10 yrs)</option>
</select>
<button class="btn" onclick="calc()">Check Eligibility</button>
<div class="res" id="res">
<div class="label">Your Age at Cutoff</div>
<div class="big" id="age">—</div>
<div id="verdict" style="font-size:.85rem;margin-top:4px"></div>
<ul id="details"></ul>
</div>
<div class="share">
<span style="font-size:.72rem;color:#5a6f88;align-self:center">Share:</span>
<a class="wa" href="https://wa.me/?text=Check%20Age%20Eligibility%3A%20https://unknownuniversem-blip.github.io/age-eligibility-calc/" target="_blank">💬 WhatsApp</a>
<a class="tg" href="https://t.me/share/url?url=https://unknownuniversem-blip.github.io/age-eligibility-calc/" target="_blank">✈️ Telegram</a>
</div>
</div>
<script>
const $=i=>document.getElementById(i);
const RANGES={ssc:[18,32],upsc:[21,32],ibps:[20,30],railways:[18,33]};
const RELAX={gen:0,obc:3,scst:5,pwd:10};
$("exam").onchange=()=>{$("customBox").style.display=$("exam").value==="custom"?"block":"none"};
function calc(){
  const dob=new Date($("dob").value),cut=new Date($("cutoff").value);
  if(isNaN(dob)||isNaN(cut))return alert("Enter both dates");
  let y=cut.getFullYear()-dob.getFullYear(),m=cut.getMonth()-dob.getMonth(),d=cut.getDate()-dob.getDate();
  if(d<0){m--;d+=new Date(cut.getFullYear(),cut.getMonth(),0).getDate()}
  if(m<0){y--;m+=12}
  const age=y+m/12;
  let rng;
  if($("exam").value==="custom")rng=[+$("minAge").value,+$("maxAge").value];
  else rng=RANGES[$("exam").value];
  const relax=RELAX[$("cat").value];
  const maxAge=rng[1]+relax;
  $("age").textContent=y+"y "+m+"m";
  const ok=age>=rng[0]&&age<=maxAge;
  $("verdict").textContent=ok?"✅ ELIGIBLE":"❌ NOT ELIGIBLE";
  $("verdict").style.color=ok?"#c8e6c9":"#ff8a80";
  $("details").innerHTML=`
    <li>Min age: ${rng[0]} years</li>
    <li>Max age (base): ${rng[1]} years</li>
    <li>Category relaxation: +${relax} years</li>
    <li>Effective max: ${maxAge} years</li>
    <li>${age<rng[0]?"Under minimum age":"Meets minimum age"}</li>
    <li>${age>maxAge?"Over maximum age":"Within maximum age"}</li>`;
  $("res").style.display="block";
}
$("dob").valueAsDate=new Date(2000,0,1);
$("cutoff").valueAsDate=new Date();
</script></body></html>

